package com.example.lockspvp;

import java.util.Set;

public class HiddenKeys {
    public static final Set<String> HIDDEN = Set.of(
        "key.attack",
        "key.use"
    );

    public static boolean showHidden = false;
    public static double savedScroll = 0;
}


